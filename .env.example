# Pixal3D Studio Environment Configuration

# JWT secret key (CHANGE THIS in production! Use a long random string)
SECRET_KEY=change-me-to-a-long-random-string

# Admin account credentials (created on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Pixal3D model path (HuggingFace repo ID or local path)
PIXAL3D_MODEL_PATH=TencentARC/Pixal3D

# Low VRAM mode (set to 1 for GPUs with < 16GB VRAM)
LOW_VRAM=0

# Attention backend: sdpa (recommended for Blackwell GPUs), flash_attn, or flash_attn_2
ATTN_BACKEND=sdpa

# Server port
PORT=8000

# HuggingFace token (needed for gated models like briaai/RMBG-2.0)
# Get one at https://huggingface.co/settings/tokens
# Accept the license at https://huggingface.co/briaai/RMBG-2.0 first
# HF_TOKEN=hf_your_token_here
